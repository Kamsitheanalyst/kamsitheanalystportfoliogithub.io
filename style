/* GENERAL STYLING */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #ffffff;
    color: #172536;
    line-height: 1.7;
}

/* NAVIGATION */

header {
    border-bottom: 1px solid #edf0f3;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 22px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    color: #14283f;
    text-decoration: none;
    letter-spacing: 2px;
}

.logo span {
    color: #19a89b;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: #435166;
    font-size: 14px;
    font-weight: 600;
}

.nav-links a:hover {
    color: #19a89b;
}

/* HERO SECTION */

.hero {
    max-width: 1200px;
    margin: auto;
    padding: 110px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 60px;
}

.hero-photo {
    width: 100%
    height: 100%
    object-fit: cover;
    border-radius: 12px;
}

.hero-content {
    max-width: 650px;
}

.eyebrow,
.section-label {
    color: #19a89b;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.15;
    margin-bottom: 22px;
    color: #14283f;
}

.hero h1 span {
    color: #19a89b;
}

.hero h2 {
    font-size: 19px;
    color: #435166;
    margin-bottom: 18px;
}

.hero-description {
    color: #667386;
    max-width: 550px;
    margin-bottom: 30px;
}

/* BUTTONS */

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.btn {
    padding: 13px 23px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

.primary-btn {
    background: #14283f;
    color: white;
}

.primary-btn:hover {
    background: #19a89b;
}

.secondary-btn {
    border: 1px solid #14283f;
    color: #14283f;
}

.secondary-btn:hover {
    background: #14283f;
    color: white;
}

/* HERO VISUAL */

.hero-visual {
    width: 300px;
    height: 330px;
    background: #eaf5f4;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
}

.visual-card {
    width: 230px;
    padding: 30px;
    background: white;
    box-shadow: 0 15px 40px rgba(20, 40, 63, 0.08);
    border-radius: 8px;
}

.visual-label {
    font-size: 12px;
    color: #19a89b;
    font-weight: bold;
    letter-spacing: 2px;
}

.visual-symbol {
    font-size: 65px;
    font-weight: 800;
    color: #14283f;
    margin: 15px 0;
}

.visual-card p {
    color: #667386;
    font-size: 14px;
}

/* ABOUT SECTION */

.about-preview {
    padding: 90px 7%;
    background: #f7f9fb;
    text-align: center;
}

.about-preview h2,
.expertise h2 {
    font-size: 34px;
    color: #14283f;
    margin-bottom: 20px;
}

.about-preview > p:not(.section-label) {
    max-width: 700px;
    margin: 0 auto 25px;
    color: #667386;
}

.text-link {
    color: #19a89b;
    text-decoration: none;
    font-weight: bold;
}

/* EXPERTISE SECTION */

.expertise {
    padding: 90px 7%;
    text-align: center;
}

.expertise-grid {
    max-width: 1100px;
    margin: 45px auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.expertise-card {
    padding: 30px;
    text-align: left;
    border: 1px solid #edf0f3;
    border-radius: 8px;
}

.expertise-card h3 {
    color: #14283f;
    margin-bottom: 12px;
}

.expertise-card p {
    color: #667386;
    font-size: 14px;
}

/* FOOTER */

footer {
    background: #14283f;
    color: white;
    text-align: center;
    padding: 25px;
    font-size: 13px;
}

/* MOBILE RESPONSIVENESS */

@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        flex-direction: column;
        padding: 75px 7%;
        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-visual {
        width: 100%;
        max-width: 300px;
    }

    .expertise-grid {
        grid-template-columns: 1fr;
    }

}
